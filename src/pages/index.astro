---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, localePath } from '../i18n/ui';
import { copy } from '../i18n/copy';
import certPhoto from '../assets/images/gallery-certificate-1.jpg';
import galleryCert2 from '../assets/images/gallery-certificate-2.jpg';
import galleryCertGroup from '../assets/images/gallery-certificate-group.jpg';
import galleryHandsOn from '../assets/images/gallery-hands-on-class-1.jpg';
import galleryFood from '../assets/images/gallery-food-tobiko-orange.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = copy[lang].home;

const featuredCourseIds = ['beginner', 'professional', 'advanced-professional', 'roll-together'];
const courses = (
  await Promise.all(featuredCourseIds.map((id) => getEntry(lang === 'de' ? 'coursesDe' : 'courses', id)))
).filter((c) => c !== undefined);

const galleryTeaser = [galleryCertGroup, galleryCert2, galleryHandsOn, galleryFood].map((src, i) => ({
  src,
  alt: c.teaserAlts[i],
}));
---

<BaseLayout
  title={c.title}
  description={c.description}
>
  <section class="bg-[var(--color-navy)] text-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:grid-cols-2 md:items-center md:gap-16 md:py-28">
      <div class="hero-text">
        <p lang="ja" class="text-sm tracking-[0.3em] text-white/60">
          グローバル寿司アカデミー
        </p>
        <h1 class="mt-6 font-[family-name:var(--font-display)] text-5xl leading-tight md:text-6xl">
          {c.heroLine1}<br />
          <span class="text-[var(--color-accent-on-dark)]">{c.heroLine2}</span>
        </h1>
        <p class="mt-8 max-w-md text-lg leading-relaxed text-white/80">{c.heroBody}</p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={localePath(lang, '/courses')}
            class="bg-[var(--color-gold)] px-6 py-3 text-[var(--color-ink)] transition-opacity hover:opacity-90"
          >
            {t('cta.courses')}
          </a>
          <a
            href={localePath(lang, '/contact')}
            class="border border-white/40 px-6 py-3 text-white transition-colors hover:border-white hover:bg-white/10"
          >
            {t('cta.contact')}
          </a>
        </div>
      </div>

      <div class="hero-image relative">
        <Image
          src={certPhoto}
          alt={c.heroImageAlt}
          width={720}
          class="w-full object-cover"
        />
        <p class="absolute -bottom-4 left-4 border-l-4 border-[var(--color-gold)] bg-[var(--color-navy)] py-2 pl-4 pr-5 text-sm text-white/90">
          {c.heroCaption}
        </p>
      </div>
    </div>
  </section>

  <section class="reveal mx-auto max-w-6xl px-4 py-20">
    <h2 class="font-[family-name:var(--font-display)] text-3xl">{c.whyHeading}</h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {
        c.benefits.map((b) => (
          <div class="border-t-2 border-[var(--color-gold)] pt-4">
            <h3 class="font-[family-name:var(--font-display)] text-lg">{b.title}</h3>
            <p class="mt-2 text-[var(--color-muted)]">{b.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="reveal border-t border-[var(--color-line)] bg-[var(--color-line)]/40 py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-[family-name:var(--font-display)] text-3xl">{c.coursesHeading}</h2>
        <a href={localePath(lang, '/courses')} class="text-sm text-[var(--color-accent)] hover:underline">
          {c.compareAll}
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          courses.map((course) => (
            <a
              href={localePath(lang, `/courses/${course.id}`)}
              class="block border border-[var(--color-line)] bg-[var(--color-bg)] transition hover:border-[var(--color-accent)]"
            >
              {course.data.heroImage && (
                <Image
                  src={course.data.heroImage}
                  alt=""
                  width={360}
                  class="h-32 w-full object-cover"
                />
              )}
              <div class="p-4">
                <h3 class="font-[family-name:var(--font-display)] text-base">{course.data.title}</h3>
                <p class="mt-1 text-xs text-[var(--color-muted)]">{course.data.duration}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="reveal mx-auto max-w-6xl px-4 py-20">
    <h2 class="font-[family-name:var(--font-display)] text-3xl">{c.pathHeading}</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        c.paths.map((p) => (
          <a
            href={localePath(lang, p.href)}
            class="block border border-[var(--color-line)] p-6 transition hover:border-[var(--color-accent)]"
          >
            <h3 class="font-[family-name:var(--font-display)] text-lg">{p.label}</h3>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{p.body}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="reveal border-t border-[var(--color-line)] py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-[family-name:var(--font-display)] text-3xl">{c.galleryHeading}</h2>
        <a href={localePath(lang, '/gallery')} class="text-sm text-[var(--color-accent)] hover:underline">
          {c.viewGallery}
        </a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {
          galleryTeaser.map((photo) => (
            <a href={localePath(lang, '/gallery')} class="group block aspect-square overflow-hidden">
              <Image
                src={photo.src}
                alt={photo.alt}
                width={480}
                class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
              />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .hero-text {
        animation: hero-text-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      .hero-image {
        animation: hero-image-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
      }
    }

    @keyframes hero-text-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes hero-image-in {
      from {
        opacity: 0;
        transform: scale(1.04);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
  </style>
</BaseLayout>
