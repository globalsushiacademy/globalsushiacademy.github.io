---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localePath } from '../i18n/ui';

const t = useTranslations('en');
---

<BaseLayout
  title="Global Sushi Academy"
  description="Professional sushi chef training in Lübeck, Germany. Learn authentic Japanese sushi from experienced instructors, from your first roll to a professional counter."
>
  <section class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <p lang="ja" class="text-sm tracking-[0.3em] text-[var(--color-muted)]">
      グローバル寿司アカデミー
    </p>
    <h1 class="mt-6 max-w-3xl font-[family-name:var(--font-display)] text-5xl leading-tight md:text-6xl">
      From Beginner to<br />
      <span class="text-[var(--color-accent)]">Professional Sushi Chef</span>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
      Learn authentic Japanese sushi from experienced instructors in Germany.
      Professional training, academy certification, and support in connecting
      with partner restaurants.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href={localePath('en', '/courses')}
        class="bg-[var(--color-accent)] px-6 py-3 text-white transition-opacity hover:opacity-90"
      >
        {t('cta.courses')}
      </a>
      <a
        href={localePath('en', '/contact')}
        class="border border-[var(--color-ink)] px-6 py-3 transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t('cta.contact')}
      </a>
    </div>
  </section>

  <!--
    TODO(content): course tiers, certification, testimonials and gallery
    sections go here. All four are blocked on PLAN.md §11 (the source briefs
    disagree on the course list, durations and prices) and §13 (photography).
    Do not fill these with invented copy or placeholder testimonials.
  -->
</BaseLayout>
