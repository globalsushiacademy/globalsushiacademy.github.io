---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { copy } from '../i18n/copy';
import certPhoto from '../assets/images/gallery-certificate-2.jpg';
const lang = getLangFromUrl(Astro.url);
const c = copy[lang].certification;
---

<BaseLayout title={c.title} description={c.description}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">{c.eyebrow}</p>
    <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">{c.heading}</h1>


    <Image
      src={certPhoto}
      alt={c.imageAlt}
      width={800}
      class="mt-8 w-full object-cover"
    />

    <div class="markdown-body mt-10">
      <p>{c.p1}</p>

      <p>{c.p2}</p>
    </div>
  </section>
</BaseLayout>
