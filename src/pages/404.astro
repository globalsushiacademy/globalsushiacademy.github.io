---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localePath } from '../i18n/ui';

const t = useTranslations('en');
---

<BaseLayout title={t('404.title')} description={t('404.body')} noindex={true}>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="font-[family-name:var(--font-display)] text-6xl text-[var(--color-accent)]">404</p>
    <h1 class="mt-4 text-2xl">{t('404.title')}</h1>
    <p class="mt-4 text-[var(--color-muted)]">{t('404.body')}</p>
    <a
      href={localePath('en', '/')}
      class="mt-8 inline-block border border-[var(--color-ink)] px-6 py-3 hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
    >
      {t('404.home')}
    </a>
  </section>
</BaseLayout>
