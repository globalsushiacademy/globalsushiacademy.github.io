---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewNotice from '../components/ReviewNotice.astro';
---

<BaseLayout title="International Students" description="Guidance for students coming from abroad.">
  <section class="mx-auto max-w-3xl px-4 py-20">
    <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">International Students</p>
    <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">Welcome from Around the World</h1>

    <div class="mt-6">
      <ReviewNotice
        notes={[
          'Reuses the Advanced Professional course page\'s international-students wording as-is — the only source document that actually describes this support. General enough to apply site-wide, but confirm with the owner before treating it as a blanket policy for every course.',
        ]}
      />
    </div>

    <div class="markdown-body mt-10">
      <p>
        Global Sushi Academy welcomes students from around the world. Alongside your training,
        we can give you general guidance on registration, scheduling, accommodation, local
        transport and practical training arrangements.
      </p>

      <blockquote>
        <strong>Important.</strong> Visas, residence permits and employment authorization are
        decided solely by the relevant German authorities. The academy does not guarantee visa
        approval or employment, and enrollment in a course is not an offer of employment.
      </blockquote>
    </div>
  </section>
</BaseLayout>
