---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { copy } from '../i18n/copy';

const lang = getLangFromUrl(Astro.url);
const c = copy[lang].international;
---

<BaseLayout title={c.title} description={c.description}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">{c.eyebrow}</p>
    <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">{c.heading}</h1>

    <div class="markdown-body mt-10">
      <p>{c.p1}</p>

      <blockquote>
        <strong>{c.importantLabel}</strong>
        {c.important}
      </blockquote>
    </div>
  </section>
</BaseLayout>
