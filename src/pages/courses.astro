---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewNotice from '../components/ReviewNotice.astro';
import CourseIconPlaceholder from '../components/CourseIconPlaceholder.astro';
import { getLangFromUrl, localePath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Courses" description="Sushi courses at Global Sushi Academy in Lübeck, Germany.">
  <section class="mx-auto max-w-6xl px-4 py-20">
    <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">Courses</p>
    <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">
      From Beginner to Professional Sushi Chef
    </h1>

    <div class="mt-6 max-w-2xl">
      <ReviewNotice
        notes={[
          "Every course below is a first draft built from the owner's 2026 briefs and the legacy site. Prices are placeholders; durations and the course lineup itself are not yet confirmed. See PLAN.md §11.1.",
        ]}
      />
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        courses.map((course) => (
          <a
            href={localePath(lang, `/courses/${course.id}`)}
            class="block border border-[var(--color-line)] transition hover:border-[var(--color-accent)]"
          >
            {course.data.heroImage ? (
              <Image
                src={course.data.heroImage}
                alt={course.data.heroImageAlt ?? ''}
                width={480}
                class="h-40 w-full object-cover"
              />
            ) : (
              <CourseIconPlaceholder class="h-40 w-full" />
            )}
            <div class="p-6">
              <h2 class="font-[family-name:var(--font-display)] text-xl">{course.data.title}</h2>
              <p class="mt-2 text-sm text-[var(--color-muted)]">{course.data.tagline}</p>
              <dl class="mt-4 space-y-1 text-sm">
                <div class="flex justify-between gap-4">
                  <dt class="text-[var(--color-muted)]">Duration</dt>
                  <dd class="text-right">{course.data.duration}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-[var(--color-muted)]">Level</dt>
                  <dd class="text-right">{course.data.level}</dd>
                </div>
              </dl>
              {course.data.status === 'review' && (
                <p class="mt-4 text-xs uppercase tracking-wide text-[var(--color-accent)]">
                  Draft — pending review
                </p>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <h2 class="mt-20 font-[family-name:var(--font-display)] text-2xl">Compare courses</h2>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-[var(--color-line)] text-left">
            <th class="py-3 pr-4 font-semibold">Course</th>
            <th class="py-3 pr-4 font-semibold">Duration</th>
            <th class="py-3 pr-4 font-semibold">Format</th>
            <th class="py-3 font-semibold">Price</th>
          </tr>
        </thead>
        <tbody>
          {
            courses.map((course) => (
              <tr class="border-b border-[var(--color-line)] align-top">
                <td class="py-3 pr-4">
                  <a
                    href={localePath(lang, `/courses/${course.id}`)}
                    class="hover:text-[var(--color-accent)]"
                  >
                    {course.data.title}
                  </a>
                </td>
                <td class="py-3 pr-4 text-[var(--color-muted)]">{course.data.duration}</td>
                <td class="py-3 pr-4 text-[var(--color-muted)]">{course.data.format}</td>
                <td class="py-3 text-[var(--color-muted)]">{course.data.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
