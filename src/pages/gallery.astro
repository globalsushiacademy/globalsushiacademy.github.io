---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { copy } from '../i18n/copy';
import cert1 from '../assets/images/gallery-certificate-1.jpg';
import cert2 from '../assets/images/gallery-certificate-2.jpg';
import cert3 from '../assets/images/gallery-certificate-3.jpg';
import certGroup from '../assets/images/gallery-certificate-group.jpg';
import handsOnClass1 from '../assets/images/gallery-hands-on-class-1.jpg';
import handsOnClass2 from '../assets/images/gallery-hands-on-class-2.jpg';
import graduationGroup from '../assets/images/gallery-graduation-group.jpg';
import academyBuilding from '../assets/images/gallery-academy-building.jpg';
import tobikoGreen from '../assets/images/gallery-food-tobiko-green.jpg';
import tobikoOrange from '../assets/images/gallery-food-tobiko-orange.jpg';
import salmonLeaf from '../assets/images/gallery-food-salmon-leaf.jpg';
import sesameRoll from '../assets/images/gallery-food-sesame-roll.jpg';

const lang = getLangFromUrl(Astro.url);
const c = copy[lang].gallery;

// `wide` spans two grid columns — reserved for landscape shots with enough
// going on to earn the extra width (the group photo, the working kitchen).
const photos = [
  {
    src: certGroup,
    alt: c.alts[0],
    wide: true,
  },
  {
    src: cert1,
    alt: c.alts[1],
  },
  {
    src: cert2,
    alt: c.alts[2],
  },
  {
    src: handsOnClass2,
    alt: c.alts[3],
    wide: true,
  },
  {
    src: cert3,
    alt: c.alts[4],
  },
  {
    src: handsOnClass1,
    alt: c.alts[5],
  },
  {
    src: graduationGroup,
    alt: c.alts[6],
  },
  { src: tobikoGreen, alt: c.alts[7], },
  { src: tobikoOrange, alt: c.alts[8], },
  { src: salmonLeaf, alt: c.alts[9], },
  { src: sesameRoll, alt: c.alts[10], },
  {
    src: academyBuilding,
    alt: c.alts[11],
    width: 304, // native resolution of this one legacy file — do not upscale
  },
];
---

<BaseLayout
  title={c.title}
  description={c.description}
>
  <section class="mx-auto max-w-6xl px-4 py-20">
    <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">{c.title}</p>
    <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">{c.heading}</h1>


    <div class="gallery-grid mt-12 grid auto-rows-[180px] grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {
        photos.map((photo, i) => (
          <a
            href={`#photo-${i}`}
            class:list={[
              'group block overflow-hidden bg-[var(--color-line)]',
              photo.wide && 'col-span-2 row-span-2',
            ]}
            aria-label={c.enlarge}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              width={photo.width ?? 640}
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
            />
          </a>
        ))
      }
    </div>
  </section>

  {
    photos.map((photo, i) => (
      <div id={`photo-${i}`} class="lightbox" role="dialog" aria-label={photo.alt}>
        <a href="#" class="lightbox-backdrop" aria-label={c.close}></a>
        <div class="relative mx-auto flex max-h-[85vh] max-w-4xl items-center px-4">
          <Image
            src={photo.src}
            alt={photo.alt}
            width={photo.width ?? 1400}
            class="max-h-[85vh] w-auto object-contain"
          />
          <a
            href="#"
            aria-label={c.close}
            class="absolute -top-10 right-4 text-3xl leading-none text-white hover:text-[var(--color-accent-on-dark)] sm:top-2 sm:-right-10"
          >
            ×
          </a>
        </div>
      </div>
    ))
  }

  <style>
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 50;
      align-items: center;
      justify-content: center;
    }

    .lightbox:target {
      display: flex;
    }

    .lightbox-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(14, 42, 94, 0.92); /* --color-navy, translucent */
    }
  </style>
</BaseLayout>
