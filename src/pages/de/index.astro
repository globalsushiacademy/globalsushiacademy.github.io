---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localePath } from '../../i18n/ui';

const t = useTranslations('de');
---

<BaseLayout
  title="Global Sushi Academy"
  description="Professionelle Sushi-Ausbildung in Lübeck. Lernen Sie authentisches japanisches Sushi bei erfahrenen Sushi-Meistern — vom ersten Maki bis zur professionellen Sushi-Theke."
>
  <section class="mx-auto max-w-6xl px-4 py-20 md:py-28">
    <p lang="ja" class="text-sm tracking-[0.3em] text-[var(--color-muted)]">
      グローバル寿司アカデミー
    </p>
    <h1 class="mt-6 max-w-3xl font-[family-name:var(--font-display)] text-5xl leading-tight md:text-6xl">
      Vom Anfänger zum<br />
      <span class="text-[var(--color-accent)]">Sushi-Profi</span>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-[var(--color-muted)]">
      Lernen Sie authentisches japanisches Sushi bei erfahrenen Sushi-Meistern
      in Deutschland. Professionelle Ausbildung, Akademie-Zertifikat und
      Unterstützung bei der Vermittlung an Partnerrestaurants.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href={localePath('de', '/courses')}
        class="bg-[var(--color-accent)] px-6 py-3 text-white transition-opacity hover:opacity-90"
      >
        {t('cta.courses')}
      </a>
      <a
        href={localePath('de', '/contact')}
        class="border border-[var(--color-ink)] px-6 py-3 transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
      >
        {t('cta.contact')}
      </a>
    </div>
  </section>
</BaseLayout>
