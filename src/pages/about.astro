---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { copy } from '../i18n/copy';
import portrait from '../assets/images/about-founder-portrait.jpg';
const lang = getLangFromUrl(Astro.url);
const c = copy[lang].about;
---

<BaseLayout title={c.title} description={c.description}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">{c.title}</p>
    <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">Ram Kaji Gosai</h1>
    <p class="mt-4 text-lg text-[var(--color-muted)]">{c.role}</p>

    <Image
      src={portrait}
      alt={c.portraitAlt}
      width={480}
      class="mt-8 w-full max-w-sm object-cover sm:float-right sm:ml-8"
    />


    <div class="markdown-body mt-10">
      <p>{c.intro}</p>

      <h2>{c.storyHeading}</h2>

      {c.story.map((paragraph) => <p>{paragraph}</p>)}

      <h2>{c.mannaHeading}</h2>

      <p>
        {c.mannaBefore} <a href="https://manna-restaurants.de" target="_blank" rel="noopener">Manna Sushi &amp; Grill</a>,
        {c.mannaAfter}
      </p>
    </div>
  </section>
</BaseLayout>
