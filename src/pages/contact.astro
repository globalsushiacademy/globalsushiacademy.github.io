---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { copy } from '../i18n/copy';

const lang = getLangFromUrl(Astro.url);
const c = copy[lang].contact;

const mapsHref =
  'https://www.google.com/maps/search/?api=1&query=Marienkirchhof%202-3%2C%2023552%20L%C3%BCbeck%2C%20Germany';
---

<BaseLayout title={c.title} description={c.description}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">{c.eyebrow}</p>
    <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">{c.heading}</h1>

    <div class="mt-10 markdown-body">
      <address class="not-italic">
        <strong>Global Sushi Academy</strong><br />
        Marienkirchhof 2–3<br />
        23552 Lübeck, {c.country}
      </address>

      <p>{c.inquire}</p>

      <p>
        {c.phone}: <a href="tel:+4915257560040">+49 1525 7560040</a><br />
        WhatsApp: <a href="https://wa.me/4915257560040" target="_blank" rel="noopener">+49 1525 7560040</a><br />
        {c.email}: <a href="mailto:info@globalsushiacademy.com">info@globalsushiacademy.com</a>
      </p>

      <p>
        <a href={mapsHref} target="_blank" rel="noopener">{c.maps}</a>
      </p>
    </div>
  </section>
</BaseLayout>
