---
/**
 * Draft-content flag for course pages built from the owner's briefs before
 * PLAN.md §11 is resolved. Distinct from LegalStub's "do not publish" — this
 * is real content, just not yet signed off. Remove the wrapping check (and
 * eventually this component) once every course's `status` is 'confirmed'.
 */
interface Props {
  notes: string[];
}
const { notes } = Astro.props;
---

{
  notes.length > 0 && (
    <div class="border-2 border-[var(--color-accent)] p-4 text-sm">
      <p class="font-semibold uppercase tracking-wide text-[var(--color-accent)]">
        Draft — needs owner review before publishing
      </p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-[var(--color-muted)]">
        {notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  )
}
