---
/**
 * Wrapper for the two legally mandatory pages (Impressum, Datenschutz).
 *
 * Was originally a checklist-only stub, deliberately not filled with
 * plausible-looking text. Now takes real drafted content via the default
 * slot (built from manna-restaurants.de's e-recht24.de-style template, the
 * same one the owner's sister business uses), plus an optional `items` list
 * for whatever's still genuinely missing — e.g. the VAT ID / legal form /
 * register entry, which depend on whether this is the same registration as
 * Manna Sushi & Grill (owner hasn't confirmed either way).
 *
 * The warning banner stays until every `items` entry is resolved — a wrong
 * Impressum is worse than an obviously unfinished one.
 */
interface Props {
  heading: string;
  intro: string;
  items?: string[];
}
const { heading, intro, items = [] } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-20">
  {items.length > 0 && (
    <div class="border-2 border-[var(--color-accent)] p-4 text-sm">
      <strong class="text-[var(--color-accent)]">Not complete — do not publish.</strong>
      This page is legally required before the site goes live.
    </div>
  )}

  <h1 class="mt-8 font-[family-name:var(--font-display)] text-4xl">{heading}</h1>
  <p class="mt-6 text-[var(--color-muted)]">{intro}</p>

  {items.length > 0 && (
    <ul class="mt-6 list-disc space-y-2 pl-6 text-[var(--color-muted)]">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  )}

  <div class="markdown-body mt-10">
    <slot />
  </div>
</section>
