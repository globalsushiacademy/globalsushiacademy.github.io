---
/**
 * Scaffold-only stub. Every route in the information architecture exists so
 * navigation and link-checking are honest, but the copy is blocked on the
 * content decisions in PLAN.md §11 (the course list, prices and career
 * wording all contradict each other in the source briefs).
 *
 * Delete this component once every page has real content.
 */
interface Props {
  heading: string;
  blockedOn?: string;
}
const { heading, blockedOn } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-20">
  <p class="text-xs uppercase tracking-widest text-[var(--color-accent)]">In progress</p>
  <h1 class="mt-3 font-[family-name:var(--font-display)] text-4xl">{heading}</h1>
  <p class="mt-6 text-[var(--color-muted)]">
    This page is part of the agreed site structure but has no final copy yet.
  </p>
  {
    blockedOn && (
      <p class="mt-4 border-l-2 border-[var(--color-accent)] pl-4 text-sm text-[var(--color-muted)]">
        <strong>Blocked on:</strong> {blockedOn}
      </p>
    )
  }
  <slot />
</section>
