---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, alternatePath, localePath } from '../i18n/ui';
import notoSansUrl from '../assets/fonts/noto-sans-latin.woff2?url';
import zenOldMinchoUrl from '../assets/fonts/zen-old-mincho-400-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Set true on pages that should not be indexed (thank-you pages, 404). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(alternatePath(lang, Astro.url), Astro.site);
const otherLang = lang === 'en' ? 'de' : 'en';

const fullTitle = title === t('site.name') ? title : `${title} | ${t('site.name')}`;
---

<!doctype html>
<html lang={lang === 'de' ? 'de-DE' : 'en-GB'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Self-hosted, same-origin — no third-party font request (CLAUDE.md). -->
    <link rel="preload" href={notoSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={zenOldMinchoUrl} as="font" type="font/woff2" crossorigin />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- hreflang: tells Google these are translations, not duplicates. -->
    <link rel="alternate" hreflang={lang === 'de' ? 'de-DE' : 'en-GB'} href={canonical.href} />
    <link rel="alternate" hreflang={otherLang === 'de' ? 'de-DE' : 'en-GB'} href={alternate.href} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', '/'), Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:text-white"
    >
      {t('nav.skip')}
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
